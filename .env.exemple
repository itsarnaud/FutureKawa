
# PostgreSQL — one database per country (see docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb
POSTGRES_PORT_BR=5433
POSTGRES_PORT_EC=5434
POSTGRES_PORT_CO=5435

# Used by `npx prisma db push` / `npx prisma db seed` — point this at whichever
# country database you're working on (defaults to Brazil's).
DATABASE_URL="postgresql://postgres:password@localhost:5433/mydb?schema=public"

# Redis
REDIS_PASSWORD=password
REDIS_PORT=6379

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883

# Gateway
BRAZIL_API_URL=http://localhost:3000
ECUADOR_API_URL=http://localhost:3002
COLOMBIA_API_URL=http://localhost:3003
GATEWAY_PORT=3010

# Frontend — inlined into the browser bundle at build time (see apps/fe/Dockerfile),
# so it must be reachable from wherever the browser runs, not from inside the
# Docker network. On a plain local Docker setup this is the gateway's mapped
# host port; on Codespaces/a remote host, point it at the forwarded/public
# URL for GATEWAY_PORT instead (this value is environment-specific, don't
# commit a real one here).
NEXT_PUBLIC_API_URL=http://localhost:3010/api

# Mail — Mailpit (local SMTP catcher, no auth needed, UI at http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@futurekawa.com
