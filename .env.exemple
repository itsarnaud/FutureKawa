
# PostgreSQL — one database per country (see docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb
POSTGRES_PORT_BR=5433
POSTGRES_PORT_EC=5434
POSTGRES_PORT_CO=5435
# Siège (gateway) database — auth/users only, not domain data.
POSTGRES_PORT_SIEGE=5436

# Used by `npx prisma db push` / `npx prisma db seed` — point this at whichever
# country database you're working on (defaults to Brazil's).
DATABASE_URL="postgresql://postgres:password@localhost:5433/mydb?schema=public"

# Redis
REDIS_PASSWORD=password
REDIS_PORT=6379

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883

# Gateway
BRAZIL_API_URL=http://localhost:3000
ECUADOR_API_URL=http://localhost:3002
COLOMBIA_API_URL=http://localhost:3003
GATEWAY_PORT=3010
# Signs the JWT issued at /auth/login — change this in any real deployment.
JWT_SECRET=change-me-in-production
# CORS is wide open for now (no deployment yet, dev domains vary — see
# apps/gateway/src/main.ts). Restrict it (and re-add rate limiting / the
# internal API key check, see apps/country-api) before any real deployment.


NEXT_PUBLIC_API_URL=http://localhost:3010/api

# Mail — Mailpit (local SMTP catcher, no auth needed, UI at http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@futurekawa.com
