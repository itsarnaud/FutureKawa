
# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:password@localhost:5432/mydb?schema=public"

# Redis
REDIS_PASSWORD=password
REDIS_PORT=6379

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883

# Gateway
BRAZIL_API_URL=http://localhost:3000
ECUADOR_API_URL=http://localhost:3001
COLOMBIA_API_URL=http://localhost:3002
GATEWAY_PORT=3010

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@futurekawa.com
